# ==============================================================================
# FastAPI-Driven Deception Architecture - Environment Configuration Template
# Copy this file to '.env' and adjust host/port settings as needed.
# ==============================================================================

SERVICE_NAME=deception_gateway
BIND_HOST=0.0.0.0

# Microservice Port Allocations
GATEWAY_PORT=8000
CORE_APP_PORT=8001
DECOY_SERVICE_PORT=8080
FORENSIC_ENGINE_PORT=8090
SOC_DASHBOARD_PORT=8500

# Upstream & Decoy Service Routing URLs
CORE_WEB_APP_URL=http://127.0.0.1:8001
SANDBOX_POOL_URL=http://127.0.0.1:8080

# External Backing Services (Auto-fallback to in-memory/SQLite if offline)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=deception_admin
POSTGRES_PASSWORD=change_this_in_production
POSTGRES_DB=deception_forensics_db

# Deception Engine Controls
HONEY_TOKEN_INJECTOR_ENABLED=true
TRUST_PROXY_HEADERS=true
AUTO_OPEN_BROWSER=false
